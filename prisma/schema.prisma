generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  USER
  ADMIN
}

model Role {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users User[]
}

model User {
  id           String      @id @default(uuid())
  name         String?
  email        String      @unique
  password     String      @map("password_hash")
  jobTitle     String?
  isVerified   Boolean     @default(false)

  // OTP fields for email verification
  otp          String?
  otpExpiry    DateTime?   @map("otp_expiry")

  // OTP fields for password reset
  passwordResetOtp          String?   @map("password_reset_otp")
  passwordResetOtpExpiry    DateTime? @map("password_reset_otp_expiry")

  // SSO fields for Vettly authentication
  vettlyUserId              String?   @unique @map("vettly_user_id")
  isSSOUser                 Boolean   @default(false) @map("is_sso_user")
  lastSSOLoginAt            DateTime? @map("last_sso_login_at")

  userType     UserType    // USER or ADMIN 

  roleId       Int?
  role         Role?       @relation(fields: [roleId], references: [id])

  // relations
  resumes      Resume[] 
  generatedResumes GeneratedResume[]
  activities   ActivityLog[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([email])
  @@index([userType])
}

model Resume {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileUrl        String
  fileName       String
  mimeType       String

  appwriteFileId String?
  virtualPath    String?
  rawText        String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  version       ResumeVersions[]
  generatedResumes GeneratedResume[]

  @@index([userId])
}

model GeneratedResume {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  version   Int      @default(1)

  fileName  String
  fileUrl   String
  fileSize  Int?
  
  createdAt DateTime @default(now())
  
  @@index([resumeId])
}

model ResumeVersions {
  id        String   @id @default(uuid())
  jobTitle  String?  
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String    

  section   String
  content   String

  version   Int      @default(1)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action      String   // e.g., "UPLOAD_RESUME", "USER_REGISTER", "GENERATE_PDF"
  description String?
  metadata    Json?    // Store extra details (e.g., file names, IDs)
  ipAddress   String? 
  
  createdAt   DateTime @default(now())

  @@index([userId])
}

model SystemSettings {
  id              Int     @id @default(1) // Singleton pattern
  allowRegistration Boolean @default(true)
  maintenanceMode   Boolean @default(false)
  supportEmail      String?
  
  maxUploadSize     Int     @default(5242880) // 5MB in bytes
  
  updatedAt       DateTime @updatedAt
}
