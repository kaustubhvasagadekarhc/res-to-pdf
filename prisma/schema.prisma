generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id                        String            @id @default(uuid())
  name                      String?
  email                     String            @unique
  password                  String            @map("password_hash")
  jobTitle                  String?
  isVerified                Boolean           @default(false)
  otp                       String?
  otpExpiry                 DateTime?         @map("otp_expiry")
  userType                  UserType
  roleId                    Int?
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")
  password_reset_otp        String?
  password_reset_otp_expiry DateTime?
  activities                ActivityLog[]
  generatedResumes          GeneratedResume[]
  resumes                   Resume[]
  role                      Role?             @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([userType])
}

model Resume {
  id               String            @id @default(uuid())
  userId           String
  fileUrl          String
  fileName         String
  mimeType         String
  appwriteFileId   String?
  virtualPath      String?
  rawText          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  generatedResumes GeneratedResume[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  version          ResumeVersions[]

  @@index([userId])
}

model GeneratedResume {
  id        String   @id @default(uuid())
  resumeId  String
  fileName  String
  fileUrl   String
  fileSize  Int?
  createdAt DateTime @default(now())
  userId    String
  version   Int      @default(1)
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ResumeVersions {
  id        String   @id @default(uuid())
  jobTitle  String?
  resumeId  String
  section   String
  content   String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fileName  String
  fileUrl   String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  description String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SystemSettings {
  id                Int      @id @default(1)
  allowRegistration Boolean  @default(true)
  maintenanceMode   Boolean  @default(false)
  supportEmail      String?
  maxUploadSize     Int      @default(5242880)
  updatedAt         DateTime @updatedAt
}

enum UserType {
  USER
  ADMIN
}
